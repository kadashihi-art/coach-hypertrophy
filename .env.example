# Auth.js
AUTH_SECRET= # openssl rand -base64 32
AUTH_URL=https://coach-hypertrophy.vercel.app
AUTH_TRUST_HOST=true

# Resend magic link (Auth.js Resend provider also accepts AUTH_RESEND_KEY)
RESEND_API_KEY=
EMAIL_FROM=Coach Hypertrophy <onboarding@resend.dev>

# Vercel Blob (private) — AppState + auth adapter tokens
BLOB_READ_WRITE_TOKEN=

# Coach LLM (Tokia OpenAI-compat). Sem key = stub determinístico local.
# BASE: https://api.usetokia.com/v1
# Chat/explain: modelo mais avançado disponível (Claude Opus 5).
COACH_LLM_API_KEY=
COACH_LLM_BASE_URL=https://api.usetokia.com/v1
COACH_LLM_MODEL=openrouter/anthropic/claude-opus-5

# Remount/onboarding: mesmo topo (fallback = COACH_LLM_MODEL).
COACH_LLM_PLAN_MODEL=openrouter/anthropic/claude-opus-5
